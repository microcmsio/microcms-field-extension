{
  "name": "microcms-field-extension-sdk",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build:packages",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck:packages": "turbo run typecheck:packages",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "^2.11.10"
  },
  "engines": {
    "npm": ">=12.0.0",
    "node": ">=14.0.0"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.14.54": true,
    "fsevents": false
  }
}
